diff --git a/src/main/target/SITL/target.c b/src/main/target/SITL/target.c
index 6cf758db..3a0af58a 100644
--- a/src/main/target/SITL/target.c
+++ b/src/main/target/SITL/target.c
@@ -113,7 +113,12 @@ void systemInit(void) {
 
     pthread_attr_init(&thAttr);
     pthread_attr_getschedpolicy(&thAttr, &policy);
+#ifdef __ANDROID__
+    struct sched_param priority = { .sched_priority = sched_get_priority_min(policy) };
+    pthread_setschedparam(pthread_self(), policy, &priority);
+#else
     pthread_setschedprio(pthread_self(), sched_get_priority_min(policy));
+#endif
     pthread_attr_destroy(&thAttr);
 #endif
 
@@ -483,7 +488,17 @@ bool isMPUSoftReset(void)
 int lookupAddress (char *name, int port, int type, struct sockaddr *addr, socklen_t* len )
 {
     struct addrinfo *servinfo, *p;
+#ifdef __ANDROID__
+    // Bionic rejects the desktop AI_V4MAPPED/AI_ADDRCONFIG combination.
+    // The Android demo binds numeric loopback without DNS or interface probing.
+    struct addrinfo hints = {.ai_family = AF_UNSPEC, .ai_socktype = type, .ai_flags = 0};
+    if (name != NULL && strcmp(name, "127.0.0.1") == 0) {
+        hints.ai_family = AF_INET;
+        hints.ai_flags = AI_NUMERICHOST;
+    }
+#else
     struct addrinfo hints = {.ai_family = AF_UNSPEC, .ai_socktype = type, .ai_flags = AI_V4MAPPED|AI_ADDRCONFIG};
+#endif
     if (name == NULL) {
 	hints.ai_flags |= AI_PASSIVE;
     }
